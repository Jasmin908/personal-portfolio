---
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '../styles/global.css';

import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { defaultLocale, localeCodes, locales, type Locale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';
import { site } from '../data/site';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** Path of this page in every language, used for hreflang and the switcher. */
  alternates: Record<Locale, string>;
  /** Nav entry to highlight on pages that are not the home page. */
  activeNav?: string;
}

const { locale, title, description, alternates, activeNav } = Astro.props;
const t = useTranslations(locale);

const absolute = (path: string) => new URL(path, Astro.site).href;
const canonical = absolute(alternates[locale]);
const ogImage = absolute(`/og-${locale}.png`);

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: absolute(alternates[defaultLocale]),
  address: { '@type': 'PostalAddress', addressCountry: site.country },
};
---

<!doctype html>
<html lang={locales[locale].htmlLang} data-locale={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <meta name="theme-color" content="#0b0b12" />
    <link rel="canonical" href={canonical} />
    {
      localeCodes.map((code) => (
        <link rel="alternate" hreflang={locales[code].htmlLang} href={absolute(alternates[code])} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={absolute(alternates[defaultLocale])} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.meta.ogAlt} />
    <meta property="og:locale" content={locales[locale].ogLocale} />
    {
      localeCodes
        .filter((code) => code !== locale)
        .map((code) => <meta property="og:locale:alternate" content={locales[code].ogLocale} />)
    }
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(person)} />

    <!--
      Runs before first paint. German is the default; a visitor who picked a
      language earlier is sent to that version when they arrive from outside.
    -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        root.classList.add('js');
        try {
          var wanted = localStorage.getItem('lang');
          if (!wanted || !/^[a-z]{2}$/.test(wanted) || wanted === root.dataset.locale) return;
          var internal = document.referrer && new URL(document.referrer).origin === location.origin;
          if (internal) return;
          var alt = document.querySelector('link[rel="alternate"][hreflang^="' + wanted + '"]');
          if (alt) location.replace(new URL(alt.href).pathname + location.hash);
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{t.nav.skip}</a>
    <Nav locale={locale} alternates={alternates} activeNav={activeNav} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />
    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: fixed;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 100;
    padding: 0.7rem 1.1rem;
    border-radius: var(--pill);
    background: var(--lime);
    color: var(--ink);
    font-weight: 600;
    transform: translateY(-200%);
  }

  .skip-link:focus {
    transform: none;
  }
</style>
