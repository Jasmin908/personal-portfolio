---
import SkillIcon from './SkillIcon.astro';
import type { Locale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const t = useTranslations(Astro.props.locale);
const items = t.beyond.items;

// Order of the cards and their icons. Texts come from the dictionary.
const cards = [
  { key: 'languages', icon: 'speech' },
  { key: 'science', icon: 'atom' },
  { key: 'creative', icon: 'pencil' },
  { key: 'chess', icon: 'pawn' },
  { key: 'music', icon: 'music' },
  { key: 'growth', icon: 'growth' },
] as const;
---

<section class="section beyond" id="beyond" aria-labelledby="beyond-title">
  <div class="container">
    <header class="head" data-reveal>
      <p class="label" data-index="04">{t.beyond.label}</p>
      <h2 class="h2" id="beyond-title">{t.beyond.title}</h2>
      <p class="intro">{t.beyond.intro}</p>
    </header>

    <ul class="grid">
      {
        cards.map((card, index) => (
          <li class="card" data-spot data-reveal style={`--d: ${(index % 3) * 70}ms`}>
            <SkillIcon name={card.icon} />
            <h3>{items[card.key].title}</h3>
            <p>{items[card.key].text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .beyond {
    padding-top: 0;
  }

  .head {
    max-width: 44rem;
  }

  .h2 {
    margin-top: 1.25rem;
    font-size: clamp(2rem, 4.6vw, 3.5rem);
  }

  .intro {
    margin-top: 1.5rem;
    color: var(--muted);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    /* Every row takes the height of the tallest card. */
    grid-auto-rows: 1fr;
    gap: clamp(0.75rem, 1.5vw, 1.25rem);
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-height: 14rem;
    padding: clamp(1.5rem, 2.2vw, 2rem);
    border-radius: var(--r-m);
    border: 1px solid var(--line);
    background: rgb(27 26 42 / 0.55);
    overflow: hidden;
    /* Opacity and transform repeat the scroll-reveal timing from global.css. */
    transition:
      border-color 0.5s var(--ease),
      opacity 0.9s var(--ease) var(--d, 0ms),
      transform 0.9s var(--ease) var(--d, 0ms);
  }

  /* Soft light that follows the pointer (position set in site.ts). */
  .card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(24rem circle at var(--mx, 50%) var(--my, 0%), rgb(139 92 246 / 0.14), transparent 60%);
    opacity: 0;
    transition: opacity 0.5s var(--ease);
    pointer-events: none;
  }

  .card:hover {
    border-color: rgb(196 181 253 / 0.4);
  }

  .card:hover::before {
    opacity: 1;
  }

  .card:hover :global(.icon) {
    background: rgb(139 92 246 / 0.24);
    border-color: var(--violet-soft);
    color: var(--text);
  }

  h3 {
    margin-top: auto;
    padding-top: 2.5rem;
    font-size: clamp(1.3rem, 1.9vw, 1.5rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  p:not(.label, .intro) {
    max-width: 32rem;
    margin-top: 0.75rem;
    font-size: 1rem;
    line-height: 1.55;
    color: var(--muted);
  }

  @media (max-width: 1000px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .grid {
      grid-template-columns: 1fr;
    }

    .card {
      min-height: 0;
    }

    h3 {
      padding-top: 1.75rem;
    }
  }
</style>
