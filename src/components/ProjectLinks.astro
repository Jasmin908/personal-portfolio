---
import type { Project } from '../data/projects';
import type { Locale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';

/**
 * Demo and repository links. Only links that exist are shown; a project
 * without a public demo or repository simply has fewer links.
 */
interface Props {
  project: Project;
  locale: Locale;
}

const { project, locale } = Astro.props;
const t = useTranslations(locale);

const links = [
  { url: project.demoUrl, label: project.demoLabel?.[locale] ?? t.projects.demo },
  { url: project.repoUrl, label: t.projects.repo },
].filter((link): link is { url: string; label: string } => Boolean(link.url));
---

{
  links.length > 0 && (
    <ul class="links">
      {links.map((link) => (
        <li>
          <a href={link.url} target="_blank" rel="noopener noreferrer">
            {link.label} <span aria-hidden="true">↗</span>
          </a>
        </li>
      ))}
    </ul>
  )
}

<style>
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
  }

  a {
    position: relative;
    z-index: 2;
    color: var(--text);
    border-bottom: 1px solid var(--line-strong);
    transition: border-color 0.3s var(--ease);
  }

  a:hover {
    border-color: var(--lime);
  }

</style>
