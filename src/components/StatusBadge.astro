---
import type { Locale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';
import type { ProjectStatus } from '../data/projects';

interface Props {
  locale: Locale;
  status: ProjectStatus;
}

const { locale, status } = Astro.props;
const t = useTranslations(locale);
---

<span class="status" data-status={status}>
  <i aria-hidden="true"></i>{t.status[status]}
</span>

<style>
  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.35rem 0.75rem;
    border-radius: var(--pill);
    border: 1px solid var(--line-strong);
    background: rgb(11 11 18 / 0.55);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    line-height: 1.3;
    color: var(--text);
  }

  i {
    flex: none;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--muted);
  }

  /* The outline repeats the dot colour, so the status reads at a glance. */
  [data-status='completed'] {
    border-color: rgb(182 243 106 / 0.5);
  }

  [data-status='prototype'] {
    border-color: rgb(59 130 246 / 0.65);
  }

  [data-status='planned'] {
    border-style: dashed;
  }

  [data-status='completed'] i,
  [data-status='in-development'] i {
    background: var(--lime);
  }

  [data-status='in-development'] i {
    animation: pulse 2.4s ease-in-out infinite;
  }

  [data-status='prototype'] i {
    background: var(--blue);
  }

  /* Planned: an empty ring, because nothing exists yet. */
  [data-status='planned'] i {
    background: none;
    border: 1.5px solid var(--muted);
  }

  @keyframes pulse {
    50% {
      box-shadow: 0 0 0 5px rgb(182 243 106 / 0.2);
    }
  }
</style>
