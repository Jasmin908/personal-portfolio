---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ProjectCover from '../components/ProjectCover.astro';
import ProjectLinks from '../components/ProjectLinks.astro';
import StatusBadge from '../components/StatusBadge.astro';
import Arrow from '../components/Arrow.astro';
import { projects, type Project } from '../data/projects';
import { localeCodes, projectPath, sectionPath, type Locale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';
import { site } from '../data/site';

interface Props {
  locale: Locale;
  project: Project;
}

const { locale, project } = Astro.props;
const t = useTranslations(locale);
const study = project.caseStudy[locale];

const alternates = Object.fromEntries(
  localeCodes.map((code) => [code, projectPath(code, project.slug)]),
) as Record<Locale, string>;

const features = project.features?.[locale] ?? [];

const chapters = [
  { title: t.project.overview, text: study.overview },
  // Shown as a list, and only for projects that have features to list.
  ...(features.length > 0 ? [{ title: t.project.features, list: features }] : []),
  { title: t.project.problem, text: study.problem },
  { title: t.project.solution, text: study.solution },
  { title: t.project.implementation, text: study.implementation },
  { title: t.project.challenges, text: study.challenges },
  // Only for projects that describe their limits.
  ...(study.limitations ? [{ title: t.project.limitations, text: study.limitations }] : []),
  {
    title: t.project.learnings,
    text: study.learnings ?? (project.status === 'completed' ? t.project.learningsOpen : t.project.learningsPending),
    pending: !study.learnings,
  },
];

const next = projects[(projects.indexOf(project) + 1) % projects.length];
const screenshots = project.screenshots ?? [];
---

<Base
  locale={locale}
  title={`${project.title[locale]} – ${site.name}`}
  description={project.summary[locale]}
  alternates={alternates}
  activeNav="projects"
>
  <article class="project">
    <header class="top">
      <div class="aurora" aria-hidden="true"></div>
      <div class="container">
        <a class="back" href={sectionPath(locale, 'projects')}>
          <span aria-hidden="true">←</span>
          {t.project.back}
        </a>
        <p class="tagline">{project.tagline[locale]}</p>
        <h1>{project.title[locale]}</h1>
        <p class="summary">{project.summary[locale]}</p>
        {
          project.demoUrl && project.demoLabel && (
            <a class="btn btn--primary play" href={project.demoUrl} target="_blank" rel="noopener noreferrer">
              {project.demoLabel[locale]} <span aria-hidden="true">↗</span>
            </a>
          )
        }

        <dl class="meta">
          <div>
            <dt>{t.project.status}</dt>
            <dd><StatusBadge locale={locale} status={project.status} /></dd>
          </div>
          <div>
            <dt>{project.status === 'planned' ? t.projects.stackPlanned : t.projects.stack}</dt>
            <dd>{project.stack.join(' · ') || t.projects.stackOpen}</dd>
          </div>
          <div>
            <dt>{t.project.links}</dt>
            <dd><ProjectLinks project={project} locale={locale} explainEmpty /></dd>
          </div>
        </dl>
      </div>
    </header>

    <div class="container">
      <figure class:list={['hero-cover', { 'hero-cover--full': project.pixelArt && project.image }]}>
        <ProjectCover project={project} locale={locale} sizes="(min-width: 1240px) 1240px, 100vw" eager />
        {!project.image && <figcaption>{t.projects.placeholderNote}</figcaption>}
      </figure>

      <div class="chapters">
        {
          chapters.map((chapter, index) => (
            <section class="chapter" data-reveal>
              <h2>
                <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                {chapter.title}
              </h2>
              {chapter.list ? (
                <ul class="features">
                  {chapter.list.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              ) : (
                <p class:list={{ pending: chapter.pending }}>{chapter.text}</p>
              )}
            </section>
          ))
        }

        <section class="chapter" data-reveal>
          <h2>
            <span aria-hidden="true">{String(chapters.length + 1).padStart(2, '0')}</span>
            {t.project.screenshots}
          </h2>
          {
            screenshots.length > 0 ? (
              <div class="shots">
                {screenshots.map((shot) =>
                  project.pixelArt ? (
                    <img
                      class="pixel"
                      src={shot.src.src}
                      width={shot.src.width}
                      height={shot.src.height}
                      alt={shot.alt[locale]}
                      loading="lazy"
                      decoding="async"
                    />
                  ) : (
                    <Image src={shot.src} alt={shot.alt[locale]} widths={[640, 1024, 1600]} sizes="(min-width: 900px) 60vw, 100vw" />
                  ),
                )}
              </div>
            ) : (
              <p class="pending empty">
                {project.category === 'tool' && !project.demoUrl ? t.project.screenshotsConsole : t.project.screenshotsPending}
              </p>
            )
          }
        </section>
      </div>

      <nav class="after" aria-label={t.project.next}>
        <a class="next" href={projectPath(locale, next.slug)}>
          <span class="next-label">{t.project.next}</span>
          <span class="next-title">{next.title[locale]}<Arrow /></span>
        </a>
        <div class="ask">
          <p>{t.project.contactTitle}</p>
          <a class="btn btn--ghost" href={sectionPath(locale, 'contact')}>{t.project.contactCta}</a>
        </div>
      </nav>
    </div>
  </article>
</Base>

<style>
  .top {
    position: relative;
    isolation: isolate;
    padding-top: calc(var(--nav-h) + clamp(4rem, 9vw, 7rem));
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
    overflow: hidden;
  }

  .aurora {
    position: absolute;
    top: -18rem;
    right: -10rem;
    z-index: -1;
    width: 52rem;
    height: 38rem;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(139 92 246 / 0.36), rgb(59 130 246 / 0.14) 60%, transparent);
    filter: blur(50px);
  }

  .back {
    display: inline-flex;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    transition: color 0.3s var(--ease);
  }

  .back:hover {
    color: var(--text);
  }

  .tagline {
    margin-top: 3rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--violet-soft);
  }

  h1 {
    margin-top: 1rem;
    max-width: 16ch;
    font-size: clamp(2.75rem, 8.4vw, 6.75rem);
    font-weight: 800;
    line-height: 0.94;
    letter-spacing: -0.05em;
    overflow-wrap: break-word;
  }

  .summary {
    max-width: 38rem;
    margin-top: 1.75rem;
    font-size: clamp(1.1rem, 1.7vw, 1.3rem);
    color: var(--muted);
  }

  .play {
    margin-top: 2rem;
  }

  .meta {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0 2.5rem;
    margin-top: 3.5rem;
  }

  .meta div {
    padding-top: 1.1rem;
    border-top: 1px solid var(--line-strong);
  }

  dt {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  dd {
    margin-top: 0.65rem;
    font-weight: 500;
  }

  .hero-cover {
    position: relative;
    height: clamp(15rem, 44vw, 33rem);
    border-radius: var(--r-l);
    border: 1px solid var(--line);
    overflow: hidden;
  }

  /* A game scene is shown whole: its height follows the picture, so nothing is cut off. */
  .hero-cover--full {
    height: auto;
  }

  .hero-cover--full :global(img) {
    display: block;
    height: auto;
  }

  figcaption {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    padding: 0.3rem 0.7rem;
    border-radius: var(--pill);
    background: rgb(11 11 18 / 0.6);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    color: var(--muted);
  }

  .chapters {
    margin-top: clamp(3rem, 7vw, 6rem);
    border-bottom: 1px solid var(--line);
  }

  .chapter {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: 1rem 4rem;
    padding-block: clamp(2rem, 4vw, 3.25rem);
    border-top: 1px solid var(--line);
  }

  h2 {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    font-size: clamp(1.4rem, 2.4vw, 1.9rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  h2 span {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0.08em;
    color: var(--violet-soft);
  }

  .chapter p {
    max-width: 42rem;
    font-size: 1.1875rem;
    line-height: 1.6;
  }

  .pending {
    color: var(--muted);
  }

  .features {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem 2.5rem;
    max-width: 46rem;
  }

  .features li {
    position: relative;
    padding-left: 1.4rem;
    line-height: 1.45;
  }

  .features li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--lime);
  }

  .empty {
    padding: 2rem;
    border-radius: var(--r-m);
    border: 1px dashed var(--line-strong);
    font-size: 1rem;
  }

  .shots {
    display: grid;
    gap: 1.25rem;
  }

  .shots :global(img) {
    width: 100%;
    height: auto;
    border-radius: var(--r-m);
    border: 1px solid var(--line);
  }

  .shots .pixel {
    image-rendering: pixelated;
  }

  .after {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: 1.25rem;
    padding-block: clamp(3rem, 7vw, 6rem);
  }

  .next,
  .ask {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2rem;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    border-radius: var(--r-l);
    border: 1px solid var(--line);
  }

  .next {
    background: var(--surface);
    transition: border-color 0.4s var(--ease);
  }

  .next:hover {
    border-color: var(--violet-soft);
  }

  .next-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .next-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3.6vw, 2.75rem);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -0.04em;
  }

  .next-title :global(svg) {
    flex: none;
    width: 1.5rem;
    height: 1.5rem;
    transition: transform 0.4s var(--ease);
  }

  .next:hover .next-title :global(svg) {
    transform: translateX(6px);
  }

  .ask {
    align-items: flex-start;
  }

  .ask p {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.025em;
  }

  @media (max-width: 800px) {
    .meta,
    .chapter,
    .after,
    .features {
      grid-template-columns: 1fr;
    }

    .meta {
      gap: 1.5rem;
    }
  }
</style>
